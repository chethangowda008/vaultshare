{
  "name": "vaultshare",
  "version": "3.1.0",
  "description": "VaultShare 2.0 \u2014 Secure Intelligent Cloud File Management and Sharing System (client-side AES-256-GCM, zero-knowledge)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/integration.test.mjs",
    "lint": "eslint public/js/**/*.js server.js",
    "build": "echo 'No build step required \u2014 static HTML/CSS/JS'",
    "deploy": "npm run test && npm start",
    "test:crypto": "node --experimental-vm-modules tests/crypto.test.js"
  },
  "keywords": [
    "encryption",
    "AES-256",
    "PBKDF2",
    "file-sharing",
    "web-crypto",
    "zero-knowledge",
    "security"
  ],
  "author": "VaultShare",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "jsqr": "^1.4.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.0.3"
  }
