# ─────────────────────────────────────────────────────────────
# VaultShare — environment configuration
# Copy this file to ".env" and fill in what you need.
# NEVER commit your real .env file (it is listed in .gitignore).
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development            # use "production" when deployed behind HTTPS

# Sessions (leave empty to auto-generate and store a secret in data/)
SESSION_SECRET=

# ─── SINGLE ADMIN CREDENTIALS (REQUIRED) ────────────────────
# There is ONE and ONLY ONE admin account. Set these here.
# The admin logs in at /admin-login.html with these credentials.
# Do NOT hard-code your real values here — put them in your .env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Database: VaultShare uses a local SQLite file at data/vaultshare.db.
DATABASE_URL=

# Recycle Bin: default days before deleted files are permanently removed.
RECYCLE_BIN_RETENTION_DAYS=30

# Rate limits (defaults are strict; raise only for automated tests)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10

# Reserved for future use
ENCRYPTION_CONFIG=
